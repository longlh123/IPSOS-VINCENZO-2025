{
    "nps-dataset-1" : {
        "title": "BENCHMARKING",
        "time-mode" : [
            { "name": "wave", "label": "Wave", "checked": 1 },
            { "name": "quarter", "label": "Quarter", "checked": 0 }
        ],
        "main-filters" : {
            "Wave" : [],
            "Quarter" : [],
            "Bank" : [],
            "Segment" : [],
            "City" : [],
            "Sample" : [],
            "NPS_Category" : []
        },
        "group-by" : ["Bank", "Wave", "Quarter"],
        "used-cols" : [ "DummyID", "Wave", "Quarter", "S1c", "Q0", "S0", "Q1", "Q2", "Q9a_R1", "Q9a_R2", "Q9a_R4", "Q9a_R6", "Q9a_R7", "Q9a_R8", "Q9a_R9", "Q9_R1", "Q9_R2", "Q9_R3", "Q9_R4", "Q9_R6" ],
        "renamed-columns" : {
            "DummyID" : "ID",
            "Q0": "Segment",
            "S1c": "City",
            "S0": "Sample",
            "Q1" : "Bank",
            "Q2" : "NPS_Score"
        },
        "add-custom-columns": {
            "NPS_Category": "('Promoter' if row['NPS_Score'] >= 9 else ('Passive' if row['NPS_Score'] >= 7 else 'Detractor'))"
        },
        "charts" : [
            {
                "name" : "NPS",
                "title" : "NPS Product",
                "type" : "NPSBarChartWidget",
                "xAxis" : {
                    "label" : "NPS_Score",
                    "format" : "percent",
                    "min" : 0,
                    "max" : 100
                },
                "yAxis" : {
                    "label" : "Bank",
                    "categories" : ["ACB", "BIDV", "MBBank", "Techcombank", "VPBank", "Vietcombank"]
                },
                "style": {
                    "colors": ["#008a3e", "#ffc000", "#7f7f7f"],
                    "barHeight": 20,
                    "gap": 10,
                    "showValueLabel": true
                }
            },
            {
                "name" : "CSAT",
                "title" : "CSAT Channel",
                "type" : "CSATBarChartWidget",
                "filter-mapping": {
                    "Branch": "Q9_R1",
                    "Telesales": "Q9_R2",
                    "Call Center": "Q9_R3",
                    "Fanpage": "Q9_R4",
                    "ATM": "Q9_R6"
                },
                "xAxis" : {
                    "label" : "Q9_R1",
                    "categories" : [ "CSAT_5", "CSAT_4", "CSAT_3", "CSAT_2", "CSAT_1" ],
                    "format" : "percent",
                    "min" : 0,
                    "max" : 100
                },
                "yAxis" : {
                    "label" : "Bank",
                    "categories" : ["ACB", "BIDV", "MBBank", "Techcombank", "VPBank", "Vietcombank"]
                },
                "style": {
                    "colors": ["#4caf50","#e3e4e6","#e3e4e6","#e3e4e6","#e3e4e6"],
                    "barHeight": 20,
                    "gap": 10,
                    "showValueLabel": true
                }
            },
            {
                "name" : "CSAT",
                "title" : "CSAT Product",
                "type" : "CSATBarChartWidget",
                "filter-mapping": {
                    "Debit Card": "Q9a_R1",
                    "Credit Card": "Q9a_R2",
                    "Banca": "Q9a_R4",
                    "Terms Deposit": "Q9a_R6",
                    "Bond/ Funds": "Q9a_R7",
                    "Secured Loan": "Q9a_R8"
                },
                "xAxis" : {
                    "label" : "Q9a_R1",
                    "categories" : [ "CSAT_5", "CSAT_4", "CSAT_3", "CSAT_2", "CSAT_1" ],
                    "format" : "percent",
                    "min" : 0,
                    "max" : 100
                },
                "yAxis" : {
                    "label" : "Bank",
                    "categories" : ["ACB", "BIDV", "MBBank", "Techcombank", "VPBank", "Vietcombank"]
                },
                "style": {
                    "colors": ["#4caf50","#e3e4e6","#e3e4e6","#e3e4e6","#e3e4e6"],
                    "barHeight": 20,
                    "gap": 10,
                    "showValueLabel": true
                }
            }
        ]
    }
}